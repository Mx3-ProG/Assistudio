{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "studio-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "STUDIO_DEMO_MODE": "true"
      }
    }
  ]
}