# ---------------------------------------------------------------------------
# STUDIO — environment variables (copy to .env.local; never commit real keys)
#
# Without NEXT_PUBLIC_SUPABASE_URL the app runs in DEMO MODE (local dev only):
# in-memory, clearly-labelled fake data. Demo mode can never run in production.
#
# Only NEXT_PUBLIC_* values reach the browser. Everything else is server-only:
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, SUPABASE_SERVICE_ROLE_KEY and
# RESEND_API_KEY must never be prefixed with NEXT_PUBLIC_.
#
# Test vs live: use Stripe TEST keys (sk_test_…) everywhere except the
# production deployment. The app refuses a live key outside production and a
# test key on production.
# ---------------------------------------------------------------------------

# Public URL of the app (referral links, Stripe redirect URLs, email links)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Used by webhooks, cron, click/lead ingestion.
SUPABASE_SERVICE_ROLE_KEY=
# (The newer key names NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY are also accepted.)

# Stripe (Developers → API keys). Test mode for development and staging.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint https://<site>/api/webhooks/stripe
# (local: `npm run stripe:listen` prints a whsec_… for the CLI forwarder)
STRIPE_WEBHOOK_SECRET=
# Optional: signing secret of a separate Connect webhook endpoint (account.updated)
STRIPE_CONNECT_WEBHOOK_SECRET=
# Staging project on the production deployment only: allow a test key there
# STRIPE_ALLOW_TEST_MODE_IN_PRODUCTION=true

# Transactional emails (Resend): welcome, leads, payouts… Sign-in codes are sent
# by Supabase Auth instead (see README → Sign-in). Without a key, emails are
# logged instead of sent (dev only); on production every send fails.
RESEND_API_KEY=
# The domain must be verified in Resend (Domains → atonservice.org, DNS records
# at your registrar), or Resend only delivers to your own address.
# Defaults: "Studio ATS <contact@atonservice.org>" / contact@atonservice.org
EMAIL_FROM="Studio ATS <contact@atonservice.org>"
EMAIL_REPLY_TO=contact@atonservice.org

# Bearer secret for /api/cron/daily (Vercel Cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=

# Salt for hashing IPs / user agents in click tracking (fraud signals). Use a long random value.
TRACKING_HASH_SALT=

# Supabase "Email OTP Length" if it is not 6 (the login form auto-submits at this length)
# NEXT_PUBLIC_AUTH_OTP_LENGTH=6

# Optional OAuth providers enabled in Supabase Auth, comma-separated (e.g. google,apple)
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Force demo mode on a preview deployment (ignored on production)
# STUDIO_DEMO_MODE=true

# Optional: Studio demo shown from the partner home ("Watch a demo").
# An https URL to a video file (.mp4/.webm) or an embeddable player (YouTube /embed/, Vimeo player, Loom /embed/).
# Leave empty to hide the button.
STUDIO_DEMO_URL=

# Optional: recorded tour of the real partner space, played inside the MacBook
# of the home's #demo section (see src/content/partner-demo.ts for recording tips).
# Defaults to /public/demo/partner-space.mp4 (+ partner-space-poster.webp);
# set these only to use other files (https URLs or paths under /public).
PARTNER_DEMO_VIDEO=
PARTNER_DEMO_VIDEO_WEBM=
PARTNER_DEMO_POSTER=
# false if the video has no sound: hides "Turn sound on" (sound never autoplays)
PARTNER_DEMO_AUDIO=
