# ---------------------------------------------------------------------------
# STUDIO — environment variables
# Without NEXT_PUBLIC_SUPABASE_URL the app runs in DEMO MODE (local dev only):
# in-memory, clearly-labelled fake data. Demo mode can never run in production.
# ---------------------------------------------------------------------------

# Public site URL (used for referral links, canonical URLs, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose. Used for click/lead ingestion, cron and webhooks.
SUPABASE_SECRET_KEY=

# Optional OAuth providers enabled in Supabase Auth, comma-separated (e.g. google,apple)
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Salt for hashing IPs / user agents in click tracking (fraud signals). Use a long random value.
TRACKING_HASH_SALT=

# Bearer secret for /api/cron/daily (Vercel Cron sends it automatically when set as CRON_SECRET)
CRON_SECRET=

# Email (Resend). Without a key, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="STUDIO <no-reply@your-domain.com>"

# Force demo mode on a preview deployment (ignored on production)
# STUDIO_DEMO_MODE=true
